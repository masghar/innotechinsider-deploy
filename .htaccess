# InnotechInsider — Apache config for static hosting (Hostinger /public_html)

# Branded 404 (Astro outputs /404.html at the site root)
ErrorDocument 404 /404.html

# Article redirects — stale-year cleanup (2026-09-02). The content pipeline
# generated several evergreen "best of / top N" articles with a stale year
# baked into the title (the Gemini prompt didn't know the real current date —
# fixed in scripts/lib/gemini.mjs) and, separately, regenerated a few topics
# more than once. Each cluster was consolidated to one corrected 2026 article;
# duplicates and two articles whose actual recommendations were obsolete
# (not just mis-dated) were retired. 301s preserve any existing links/rankings.
<IfModule mod_alias.c>
  Redirect 301 /ai-apps/ai-content-creation-2025-capabilities/ /ai-apps/top-ai-tools-content-creation-2026/
  Redirect 301 /ai-apps/ai-content-creation-tools-2025-transformation/ /ai-apps/top-ai-tools-content-creation-2026/
